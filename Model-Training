    "def evaluate_model(y_train, y_test, train_pred, test_pred, train_prob, test_prob):\n",
    "    metrics = {\n",
    "        \"train_acc\": accuracy_score(y_train, train_pred),\n",
    "        \"test_acc\": accuracy_score(y_test, test_pred),\n",
    "        \"precision\": precision_score(y_test, test_pred, average=\"weighted\"),\n",
    "        \"recall\": recall_score(y_test, test_pred, average=\"weighted\"),\n",
    "        \"roc_auc\": roc_auc_score(y_test, test_prob, multi_class=\"ovo\", average=\"weighted\")\n",
    "    }\n",
    "\n",
    "    print(\"Train Acc:\", metrics[\"train_acc\"])\n",
    "    print(\"Test  Acc:\", metrics[\"test_acc\"])\n",
    "    print(\"Precision:\", metrics[\"precision\"])\n",
    "    print(\"Recall   :\", metrics[\"recall\"])\n",
    "    print(\"ROC AUC  :\", metrics[\"roc_auc\"])\n",
    "    print(\"\\nClassification Report\\n\", classification_report(y_test, test_pred))\n",
    "\n",
    "    return metrics\n",
    "    \n",
    "def plot_confusion(y_train, y_test, train_pred, test_pred):\n",
    "\n",
    "    print(\"\\nTrain Confusion Matrix\")\n",
    "    ConfusionMatrixDisplay.from_predictions(y_train, train_pred)\n",
    "    plt.show()\n",
    "\n",
    "    print(\"\\nTest Confusion Matrix\")\n",
    "    ConfusionMatrixDisplay.from_predictions(y_test, test_pred)\n",
    "    plt.show()\n",
    "\n",
    "def show_predictions(y_test, test_pred):\n",
    "    pred_df = pd.DataFrame({\"Actual\": y_test, \"Predicted\": test_pred})\n",
    "    print(\"\\nTop 5 Predictions\\n\", pred_df.head())\n",
    "\n",
    "def save_model(model, filename=\"model.pkl\"):\n",
    "    joblib.dump(model, filename)\n",
    "    print(f\"Model saved as: {filename}\")\n"
   ]
