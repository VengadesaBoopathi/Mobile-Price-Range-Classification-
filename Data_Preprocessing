","continuous_cols = detect_continuous_columns(df)\n","\n","print(\"Continuous Columns Detected:\")\n","print(continuous_cols)\n","\n","print(\"\\nUsing Box Plot To visualize Outliers in each Column\\n\")\n","\n","check_outlier_1 = ['clock_speed', 'front_cam', 'primary_cam']\n","check_outlier_2 = ['int_memory','mobile_wt',]\n","check_outlier_3 = ['px_height', 'px_width', 'ram','battery_power']\n","check_outlier_4 = ['screen_ht', 'screen_wt', 'talk_time']\n","check_outlier_5 = ['depth_cm', 'n_cores']\n","\n","groups = [check_outlier_1, check_outlier_2, check_outlier_3, check_outlier_4,check_outlier_5]\n","\n","n = len(groups)\n","ncols = 2\n","nrows = math.ceil(n / ncols)\n","\n","fig, axes = plt.subplots(nrows, ncols, figsize=(12, 4 * nrows))\n","axes = axes.flatten()\n","\n","for i, cols in enumerate(groups):\n","    plot_df = df[cols].apply(pd.to_numeric, errors='coerce')\n","    sns.boxplot(data=plot_df, orient=\"h\", ax=axes[i])\n","    axes[i].set_title(f\"Box Plot: {', '.join(cols)}\")\n","for ax in axes[n:]:\n","    ax.remove()\n","\n","plt.tight_layout()\n","plt.show()\n","\n","cols_all = check_outlier_1 + check_outlier_2 + check_outlier_3 + check_outlier_4\n","\n","summary_rows = []\n","df_clipped = df.copy()\n","\n","for col in cols_all:\n","    \n","    s = pd.to_numeric(df[col], errors='coerce').astype('float64')\n","    q1, q3 = s.quantile(0.25), s.quantile(0.75)\n","    iqr = q3 - q1\n","    lower, upper = q1 - 1.5*iqr, q3 + 1.5*iqr\n","    s_clipped = s.clip(lower=max(0,lower))\n","    df_clipped[col] = s_clipped\n","    \n","    outliers_mask = (s > upper)\n","    outliers_count = int(outliers_mask.sum())\n","    neg_before = int((s < 0).sum())\n","    neg_after = int((s_clipped < 0).sum())\n","\n","    summary_rows.append({ 'Column': col, 'Q1': q1, 'Q3': q3, 'IQR': iqr, 'Lower Bound (Q1 - 1.5*IQR)': lower, 'Upper Bound (Q3 + 1.5*IQR)': upper, 'Outlier Count': outliers_count, 'Negative Count (Before)': neg_before, 'Negative Count (After Clipping)': n